# Copia este archivo como FRONTEND/app/.env y completa los valores reales.
# El archivo .env NUNCA se sube a Git (está en .gitignore).

# URL del backend, SIN barra al final.
# Local: http://localhost:4000   ·   Producción: https://sigpa-ii-mu.vercel.app
VITE_API_URL=http://localhost:4000

# ID de cliente OAuth de Google (el mismo GOOGLE_CLIENT_ID del backend)
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
