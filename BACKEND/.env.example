# Copia este archivo como BACKEND/.env y completa los valores reales.
# El archivo .env NUNCA se sube a Git (está en .gitignore).

# Base relacional de usuarios y solicitudes de registro (PostgreSQL en Neon)
NEONDB_URL=postgresql://usuario:clave@host/neondb?sslmode=require

# Base relacional de prácticas, plazas, grupos y calificaciones (PostgreSQL en Neon)
PRACTICAS_URL=postgresql://usuario:clave@host/ms_practicas?sslmode=require

# Base no relacional de seguimiento: bitácoras, actividades, evidencias, retroalimentación (MongoDB)
MONGO_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/

# ID de cliente OAuth de Google (el mismo que usa el frontend)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Pon "true" para habilitar POST /api/login/prueba (usuarios de prueba para calificadores).
# Si no se define o tiene otro valor, esa ruta responde 404.
ENABLE_TEST_LOGIN=true

# Puerto local (opcional, por defecto 4000). En Vercel no se usa.
PORT=4000
